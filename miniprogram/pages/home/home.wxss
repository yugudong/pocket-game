.home { padding-top:30rpx; }.brand { margin-bottom:38rpx; }.brand-icon { width:90rpx; height:90rpx; border-radius:24rpx; }.brand-name { font-size:34rpx; font-weight:750; margin-bottom:5rpx; }.help { width:52rpx; height:52rpx; border:2rpx solid #d9dfd2; border-radius:50%; text-align:center; line-height:48rpx; color:#6c7c65; }
.hero { position:relative; overflow:hidden; background:#244e3a; padding:42rpx 38rpx; border-radius:32rpx; color:#fffaf0; min-height:416rpx; margin-bottom:28rpx; }.eyebrow { font-size:19rpx; letter-spacing:4rpx; color:#b9ceb0; position:relative; z-index:1; }.hero-title { font-size:66rpx; line-height:1.2; font-weight:750; margin:24rpx 0; position:relative; z-index:1; }.hero-copy { color:#c8d9c3; font-size:25rpx; line-height:1.8; position:relative; z-index:1; }.hero-chips { display:flex; gap:14rpx; margin-top:30rpx; position:relative; z-index:1; }.hero-chips text { border:1rpx solid #5d7964; padding:9rpx 15rpx; border-radius:30rpx; font-size:20rpx; }.hero-orbit { position:absolute; border:2rpx solid #6b8860; border-radius:50%; width:390rpx; height:390rpx; right:-180rpx; top:14rpx; opacity:.55; }.orbit-two { width:310rpx; height:310rpx; right:-140rpx; top:55rpx; }.hero-star { position:absolute; right:65rpx; top:120rpx; color:#d9bf77; font-size:108rpx; }
.resume { background:#eaf0df; padding:24rpx; border-radius:20rpx; margin-bottom:28rpx; font-size:25rpx; }.resume-title { font-weight:650; }.games-heading { margin:40rpx 0 22rpx; }.game-card { border:1rpx solid #e2e4d9; border-radius:28rpx; overflow:hidden; background:#fffefa; box-shadow:0 8rpx 28rpx #263b2610; }.game-art { height:250rpx; background:linear-gradient(130deg,#e6ecd7,#c5d5ae); position:relative; display:flex; align-items:center; justify-content:center; overflow:hidden; }.art-halo { width:250rpx; height:250rpx; border:1rpx solid #afbf90; border-radius:50%; position:absolute; top:25rpx; }.shield { color:#d7b869; background:#315640; font-size:77rpx; width:130rpx; height:153rpx; border:5rpx solid #bdac71; border-radius:26rpx 26rpx 65rpx 65rpx; text-align:center; line-height:132rpx; transform:rotate(-8deg); box-shadow:12rpx 15rpx 0 #6e81572b; }.art-caption { position:absolute; right:26rpx; bottom:20rpx; letter-spacing:6rpx; color:#557149; font-size:21rpx; }.game-info { padding:28rpx; }.game-name { font-size:38rpx; font-weight:700; }.game-description { margin-top:12rpx; font-size:25rpx; color:#7e8979; }.game-bottom { border-top:1rpx solid #ecede3; margin-top:25rpx; padding-top:21rpx; color:#62735b; font-size:23rpx; }.go { width:50rpx; height:50rpx; border-radius:50%; background:#24553e; color:#fff; text-align:center; line-height:50rpx; font-size:30rpx; }.coming { display:flex; gap:20rpx; align-items:center; margin-top:26rpx; padding:28rpx; border:2rpx dashed #dce2d2; border-radius:24rpx; color:#75836c; font-size:25rpx; }.coming-mark { font-size:46rpx; color:#99a68c; }.footer { text-align:center; font-size:22rpx; color:#9ba38f; margin-top:45rpx; letter-spacing:3rpx; }
.game-card{margin-bottom:24rpx}.game-art.guandan-art{background:linear-gradient(130deg,#eedbc3,#dbb890)}.guandan-art .art-halo{border-color:#c39f78}.guandan-art .art-caption{color:#8c674c}.poker-art{width:210rpx;height:185rpx;position:relative}.poker-back,.poker-front{width:114rpx;height:162rpx;border-radius:15rpx;background:#fff8e9;border:2rpx solid #d1b386;position:absolute;top:10rpx;left:24rpx;font-size:38rpx;font-weight:700;padding:12rpx 16rpx;color:#365c46;transform:rotate(-16deg);box-shadow:7rpx 10rpx 0 #8c684827}.poker-back text,.poker-front text{display:block;font-size:58rpx;text-align:center;margin-top:2rpx}.poker-front{left:95rpx;top:18rpx;transform:rotate(12deg);color:#b45147}.poker-wild{font-size:16rpx;background:#ddb969;color:#6f542f;border-radius:7rpx;padding:4rpx 8rpx;text-align:center;position:absolute;bottom:10rpx;left:16rpx}

.game-art.doudizhu-art{background:linear-gradient(130deg,#d4e5dd,#98bdad)}.doudizhu-art .art-caption{color:#426b5a}.doudizhu-art .art-halo{border-color:#87ad98}

.undercover-art{background:#213d36}.case-art{position:absolute;inset:0;color:#d2b673}.badge-one{position:absolute;left:56rpx;top:10rpx;font-size:118rpx;transform:rotate(-15deg)}.badge-two{position:absolute;right:52rpx;top:42rpx;font-size:118rpx;color:#957a56;transform:rotate(15deg)}.case-stamp{position:absolute;left:50%;top:114rpx;transform:translateX(-50%) rotate(-9deg);border:2rpx solid #d2b673;padding:4rpx 12rpx;font-size:17rpx;letter-spacing:3rpx}.undercover-art .art-caption{color:#d8cda7}
