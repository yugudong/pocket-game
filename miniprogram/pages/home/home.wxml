<view class="page home">
  <view class="row brand"><view class="row gap"><image class="brand-icon" src="/assets/avatar.png"/><view><view class="brand-name">口袋桌游</view><view class="muted">把好玩的，装进口袋</view></view></view><view class="help" bindtap="showHelp">?</view></view>
  <view class="hero"><view class="eyebrow">LET'S PLAY TOGETHER</view><view class="hero-title"><view>人齐了，</view><view>就开一桌。</view></view><view class="hero-copy"><view>放下距离，围坐一起。</view><view>你的手机，就是桌游的一部分。</view></view><view class="hero-chips"><text>面对面玩</text><text>局域网连接</text><text>无需注册</text></view><view class="hero-orbit orbit-one"></view><view class="hero-orbit orbit-two"></view><view class="hero-star">✦</view></view>
  <view wx:if="{{resume}}" class="resume row" bindtap="resumeGame"><view><view class="resume-title">还有一桌在等你</view><view class="muted">恢复上次的{{resumeName}}房间</view></view><text>继续 →</text></view>
  <view class="row games-heading"><view class="subtitle">挑一款，开始玩</view><text class="muted">{{games.length}} 款桌游</text></view>
  <view wx:for="{{games}}" wx:key="id" class="game-card" data-id="{{item.id}}" bindtap="openGame"><view class="game-art {{item.id === 'guandan' ? 'guandan-art' : item.id === 'doudizhu' ? 'doudizhu-art' : item.id === 'goodcopbadcop' ? 'undercover-art' : ''}}"><view class="art-halo"></view><view wx:if="{{item.id === 'guandan' || item.id === 'doudizhu'}}" class="poker-art"><view class="poker-back">A<text>♠</text></view><view class="poker-front">{{item.id === 'doudizhu' ? 'K' : '2'}}<text>♥</text><view class="poker-wild">{{item.id === 'doudizhu' ? '地主' : '逢人配'}}</view></view></view><view wx:elif="{{item.id === 'goodcopbadcop'}}" class="case-art"><view class="badge-one">✦</view><view class="badge-two">✦</view><view class="case-stamp">CLASSIFIED</view></view><view wx:else class="shield">✦</view><view class="art-caption">{{item.english}}</view></view><view class="game-info"><view class="row"><view class="game-name">{{item.name}}</view><text class="tag">{{item.category}}</text></view><view class="game-description">{{item.description}}</view><view class="row game-bottom"><text>{{item.players}} · {{item.duration}}</text><view class="go">↗</view></view></view></view>
  <view class="coming"><view class="coming-mark">＋</view><view><view>下一桌，还会有新玩法</view><view class="muted">更多桌游，陆续装进口袋</view></view></view>
  <view class="footer">一桌朋友 · 一段好时光</view>
</view>
