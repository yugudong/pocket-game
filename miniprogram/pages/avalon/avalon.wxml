<view class="page avalon">
  <view wx:if="{{sharePreview}}" class="card intro"><view class="crest">✦</view><view class="title">阿瓦隆</view><view class="muted">5～10 人 · 身份推理 · 面对面玩</view><view class="spacer"></view><view wx:if="{{hasInvitation}}">朋友邀请你加入「{{inviteName}}」</view><view>打开完整小程序，和身边的朋友连接同一 Wi-Fi，一起进入圆桌。</view><view class="muted">请使用微信的“前往小程序”入口。</view></view>
  <view wx:elif="{{loading}}" class="card empty">正在准备你的圆桌…</view>
  <block wx:else>
    <view wx:if="{{error}}" class="notice error">{{error}}</view>
    <view wx:if="{{networkMessage}}" class="notice">{{networkMessage}}</view>
    <view wx:if="{{inviteConflict}}" class="card invitation-card"><view class="subtitle">朋友邀请你加入「{{inviteName}}」</view><view class="muted">你目前在另一张圆桌，先退出当前房间才能加入邀请。</view><view class="spacer"></view><button class="primary" disabled="{{submitting}}" bindtap="switchInvitedRoom">退出当前房间并加入邀请</button><button class="quiet" bindtap="dismissInvitation">留在当前房间</button></view>
    <view wx:if="{{screen === 'other'}}" class="card"><view class="subtitle">掼蛋牌桌还在等你</view><view class="muted">退出当前房间后，就可以创建阿瓦隆圆桌。</view><view class="spacer"></view><button class="primary" bindtap="continueOther">继续掼蛋房间</button><button class="quiet" bindtap="leave">退出当前房间</button></view>
    <block wx:elif="{{screen === 'entry'}}">
      <view class="entry-heading"><view class="row"><view><view class="eyebrow">THE ROUND TABLE</view><view class="title">阿瓦隆</view></view><view class="crest">✦</view></view><view class="entry-copy">藏好你的身份，找出值得信任的人。</view><view class="row entry-meta"><text>5～10 人</text><text>约 30 分钟</text><text>局域网</text></view></view>
      <view class="tabs"><view class="tab {{tab === 'create' ? 'active' : ''}}" data-tab="create" bindtap="switchTab">创建房间</view><view class="tab {{tab === 'join' ? 'active' : ''}}" data-tab="join" bindtap="switchTab">加入房间</view></view>
      <view class="card">
        <view wx:if="{{hasInvitation}}" class="invitation-card"><view class="subtitle">加入「{{inviteName}}」</view><view class="muted">邀请已带上入房信息，无需口令。请连接房主所在的 Wi-Fi 或热点，并让房主保持前台。</view><view class="muted">房主 IP：{{ip}}</view><view class="spacer"></view></view>
        <text class="label">你的昵称</text><input class="input" value="{{nickname}}" data-key="nickname" bindinput="input" maxlength="16" placeholder="大家怎么称呼你？"/>
        <block wx:if="{{tab === 'create'}}"><text class="label">房间名称</text><input class="input" value="{{roomName}}" data-key="roomName" bindinput="input" maxlength="24" placeholder="给这桌起个名字"/></block>
        <block wx:elif="{{!hasInvitation}}">
          <view class="row"><text class="label">附近的阿瓦隆房间</text><view class="refresh" bindtap="refresh">刷新 ↻</view></view>
          <view wx:if="{{searchError}}" class="muted search-help">{{searchError}}</view>
          <view wx:if="{{!rooms.length}}" class="empty rooms-empty"><view class="search-dot">◎</view><view>正在寻找附近的圆桌</view><view class="muted">连接同一 Wi-Fi 或热点，让房主保持前台</view></view>
          <view wx:for="{{rooms}}" wx:key="id" class="room-option {{selectedRoom === item.id ? 'chosen' : ''}}" data-id="{{item.id}}" bindtap="chooseRoom"><view class="row"><view class="grow"><view class="room-option-name">{{item.name}}</view><view class="muted">{{item.ip}} · {{item.count}}/10 人 · {{item.playing ? '进行中，仅原玩家重连' : '等待玩家'}}</view></view><text class="room-check">{{selectedRoom === item.id ? '✓' : '○'}}</text></view></view>
          <view class="manual-link" bindtap="toggleManual">{{manual ? '收起手动输入' : '搜索不到？手动输入房主 IP'}}</view>
          <block wx:if="{{manual}}"><input class="input" value="{{ip}}" data-key="ip" bindinput="input" maxlength="15" placeholder="例如 192.168.1.8"/></block>
        </block>
        <block wx:if="{{!hasInvitation}}"><text class="label">房间口令</text><input class="input" value="{{password}}" data-key="password" bindinput="input" password maxlength="16" placeholder="4～16 个字符，告诉同桌朋友"/></block>
        <button class="primary" loading="{{submitting}}" disabled="{{submitting || !nickname || (!hasInvitation && !password) || (tab === 'join' && !ip)}}" bindtap="enter">{{hasInvitation ? '加入邀请的圆桌' : tab === 'create' ? '创建圆桌' : '加入圆桌'}}</button>
      </view>
      <view class="lan-tip"><view class="tip-symbol">◎</view><view class="grow"><view>一人一部手机，连接同一个 Wi-Fi</view><view class="muted">也可以使用手机热点。iPhone 请允许微信访问“本地网络”。首次打开需要联网，牌局通过局域网运行。</view></view></view>
    </block>
    <block wx:elif="{{!view}}"><view class="card empty">正在恢复圆桌连接…</view><button class="secondary" loading="{{submitting}}" bindtap="restore">重新连接</button><button class="quiet" bindtap="leave">退出房间</button></block>
    <block wx:else>
      <view class="row table-heading"><view class="grow"><view class="room-title">{{view.room}}</view><view class="muted">阿瓦隆 · {{players.length}} 人 · {{host ? '你是房主' : '局域网圆桌'}}</view></view><view class="connection {{connected ? 'online' : ''}}"><text class="dot"></text>{{connected ? '已连接' : '重连中'}}</view></view>
      <view wx:if="{{!connected}}" class="notice"><view>暂时无法操作，请让房主回到小程序前台。</view><view class="reconnect" bindtap="restore">重新连接 →</view></view>
      <view wx:if="{{host && view.phase === 'lobby'}}" class="ip-card row"><view class="grow"><view class="small">把口令告诉朋友，搜索这个房间即可加入</view><view class="muted">房主 IP：{{localIP || '暂未获取，请连接 Wi-Fi 后刷新'}}</view></view><view class="ip-action" bindtap="tapIP">{{localIP ? '复制' : '刷新'}}</view></view>
      <view wx:if="{{host && view.phase === 'lobby'}}" class="card"><button class="primary" open-type="share" disabled="{{!canShareRoom}}">邀请好友加入这桌</button><view class="muted invite-tip">{{canShareRoom ? '好友点击卡片即可加入，无需输入口令；请连接同一 Wi-Fi 或热点。' : '获取房主 IP 后即可分享邀请，请检查 Wi-Fi 连接。'}}</view></view>
      <view wx:if="{{!host && view.phase === 'lobby'}}" class="muted host-address">房主 IP：{{hostIP}}</view>
      <view wx:if="{{view.phase !== 'lobby'}}" class="mission-panel"><view class="row score"><text>亚瑟阵营 <text class="good-score">{{goodScore}}</text></text><text class="score-dot">✦</text><text>邪恶阵营 <text class="evil-score">{{evilScore}}</text></text></view><view class="mission-track"><view wx:for="{{missions}}" wx:key="number" class="mission {{item.status}}"><view class="mission-circle">{{item.status === 'success' ? '✓' : item.status === 'fail' ? '×' : item.number}}</view><view class="mission-size">{{item.label}}</view><view class="double-mark">{{item.double ? '需 2 张失败' : ' '}}</view></view></view></view>
      <view class="round-table"><view class="table-label"><text>THE ROUND TABLE</text><view>{{phaseName}}</view></view><view class="players-grid"><view wx:for="{{players}}" wx:key="id" class="seat {{item.selected || item.target ? 'selected' : ''}} {{item.onTeam ? 'on-team' : ''}} {{!item.online ? 'offline' : ''}} {{item.eligible ? 'eligible' : ''}}" data-id="{{item.id}}" bindtap="selectPlayer"><view class="seat-top"><text>{{item.seat}} 号</text><text wx:if="{{item.captain && view.phase !== 'lobby'}}" class="captain-tag">队长</text><text wx:elif="{{item.host}}">房主</text></view><view class="seat-avatar {{item.me ? 'self' : ''}}">{{item.initial}}<text wx:if="{{item.onTeam}}" class="team-badge">✓</text></view><view class="seat-name">{{item.name}}</view><view class="seat-status">{{item.me ? '你 · ' : ''}}{{!item.online ? '离线' : view.phase === 'lobby' ? (item.ready ? '已准备' : '未准备') : item.revealed ? item.revealed.name : (item.id === view.assassin ? '刺客' : '已入座')}}</view><view wx:if="{{host && view.phase === 'lobby' && !item.host}}" class="kick" data-id="{{item.id}}" catchtap="kick">移出</view></view></view></view>
      <view wx:if="{{view.private && view.phase !== 'over'}}" class="identity-bar row"><view><view class="small">你的秘密身份</view><view class="muted">周围无人看屏幕时再查看</view></view><button class="identity-button secondary" bindtap="showIdentity">{{showRole ? '收起身份' : '查看身份'}}</button></view>
      <view wx:if="{{showRole && view.private}}" class="identity-card {{view.private.side}}"><view class="row"><text class="identity-eyebrow">仅你可见</text><view class="identity-close" bindtap="showIdentity">收起 ×</view></view><view class="identity-name">{{view.private.name}}</view><view class="identity-side">{{view.private.side === 'good' ? '亚瑟阵营' : '邪恶阵营'}}</view><view class="identity-hint">{{view.private.hint}}</view><view wx:if="{{known.length}}" class="known-list"><view wx:for="{{known}}" wx:key="id" class="row known-player"><text>{{item.seat}} 号 · {{item.name}}</text><text>{{item.label}}</text></view></view><view wx:else class="identity-hint">没有可见的其他身份信息。</view></view>
      <view class="card action-panel">
        <block wx:if="{{view.phase === 'lobby'}}"><view class="subtitle">等朋友到齐</view><view class="muted">至少 5 人。所有玩家准备好后，由房主开始。</view><view class="spacer"></view><button class="{{my.ready ? 'secondary' : 'primary'}}" disabled="{{!canAct}}" bindtap="ready">{{my.ready ? '取消准备' : '我准备好了'}}</button><view wx:if="{{host}}" class="spacer"></view><button wx:if="{{host}}" class="primary" disabled="{{!canAct || !allReady}}" bindtap="start">开始游戏 · {{players.length}} 人</button></block>
        <block wx:elif="{{view.phase === 'reveal'}}"><view class="subtitle">先确认你的身份</view><view class="muted">查看身份和可见信息，记住后收起。{{view.confirmCount}}/{{players.length}} 人已确认。</view><view class="spacer"></view><button class="secondary" disabled="{{!canAct || view.confirmed}}" bindtap="seen">{{view.confirmed ? '已确认，等待其他人' : '我已记住身份'}}</button><view wx:if="{{host}}" class="spacer"></view><button wx:if="{{host}}" class="primary" disabled="{{!canAct || view.confirmCount !== players.length}}" bindtap="begin">开始第一轮组队</button></block>
        <block wx:elif="{{view.phase === 'team'}}"><view class="row"><view class="subtitle">第 {{view.quest}} 轮 · 队长组队</view><text class="tag">否决 {{view.rejects}}/5</text></view><view class="muted">{{captainName}} 是队长，本轮需要 {{required}} 人。{{view.quest === 4 && players.length >= 7 ? '第四轮需要两张失败牌才会失败。' : ''}}</view><view wx:if="{{isCaptain}}"><view class="selection-count">点击上方座位选择队员 · 已选 {{selected.length}}/{{required}}</view><button class="primary" disabled="{{!canAct || selected.length !== required}}" bindtap="propose">提交队伍</button></view><view wx:else class="waiting">等待队长选出队伍，大家可以先讨论。</view></block>
        <block wx:elif="{{view.phase === 'vote'}}"><view class="row"><view class="subtitle">这支队伍，值得信任吗？</view><text class="tag">{{view.voteCount}}/{{players.length}}</text></view><view class="team-copy">{{teamNames}}</view><view class="muted">过半赞成才会通过，平票视为否决。</view><view wx:if="{{view.voted}}" class="waiting">你已投{{view.myVote ? '赞成' : '反对'}}票，等待其他人。</view><view wx:else class="row gap vote-buttons"><button class="primary grow" data-approve="yes" disabled="{{!canAct}}" bindtap="vote">赞成</button><button class="danger grow" data-approve="no" disabled="{{!canAct}}" bindtap="vote">反对</button></view></block>
        <block wx:elif="{{view.phase === 'quest'}}"><view class="row"><view class="subtitle">第 {{view.quest}} 轮 · 秘密任务</view><text class="tag">{{view.cardCount}}/{{required}}</text></view><view class="team-copy">{{teamNames}}</view><view class="muted">只公布失败牌总数，不公布谁出了什么牌。</view><view wx:if="{{view.submitted}}" class="waiting">任务牌已提交，等待其余队员。</view><view wx:elif="{{!onMission}}" class="waiting">你不在本次队伍中，等待队员执行任务。</view><view wx:else class="row gap vote-buttons"><button class="primary grow" data-success="yes" disabled="{{!canAct}}" bindtap="quest">成功</button><button wx:if="{{view.private.side === 'evil'}}" class="danger grow" data-success="no" disabled="{{!canAct}}" bindtap="quest">失败</button></view></block>
        <block wx:elif="{{view.phase === 'result'}}"><view class="subtitle">第 {{view.quest}} 轮任务已结算</view><view class="muted">任务结果和组队投票可在下方查看，先讨论再进入下一轮。</view><view class="spacer"></view><button wx:if="{{host}}" class="primary" disabled="{{!canAct}}" bindtap="next">进入下一轮</button><view wx:else class="waiting">等待房主开启下一轮。</view></block>
        <block wx:elif="{{view.phase === 'assassinate'}}"><view class="subtitle">最后的机会 · 刺杀梅林</view><view class="muted">三次任务成功。{{assassinName}} 是刺客，邪恶阵营可以讨论最终目标。</view><block wx:if="{{isAssassin}}"><view class="selection-count">点击上方可选座位，选择一位好人。</view><button class="danger" disabled="{{!canAct || !target}}" bindtap="assassinate">确认刺杀</button></block><view wx:else class="waiting">等待刺客选择，梅林请继续隐藏身份。</view></block>
        <block wx:elif="{{view.phase === 'over'}}"><view class="end-emblem">{{view.winner === 'good' ? '✦' : '☾'}}</view><view class="end-title">{{view.winner === 'good' ? '亚瑟阵营胜利' : '邪恶阵营胜利'}}</view><view class="muted end-reason">{{view.reason}}</view><view class="spacer"></view><button wx:if="{{host}}" class="primary" disabled="{{!canAct}}" bindtap="again">再来一局</button><view wx:else class="waiting">等待房主开启下一局。</view></block>
        <view wx:if="{{busy}}" class="muted confirming">正在等待房主确认操作…</view>
      </view>
      <view wx:if="{{view.phase === 'lobby'}}" class="card"><view class="subtitle">本局角色</view><view class="muted config-sub">梅林、刺客始终在场，其余角色可选。更改配置后需要重新准备。</view><view wx:for="{{roleOptions}}" wx:key="key" class="role-row row"><view><view>{{item.name}}</view><view class="muted">{{item.hint}}</view></view><switch checked="{{item.on}}" disabled="{{!host || !canAct}}" color="#24553e" data-key="{{item.key}}" bindchange="toggleRole"/></view><view class="roster">{{roster || configError}}</view></view>
      <view wx:if="{{history.length}}" class="card"><view class="subtitle">圆桌记录</view><view wx:for="{{history}}" wx:key="key" wx:for-item="record" class="history-item"><view class="row"><view class="small history-title">{{record.title}}</view></view><view class="history-description">{{record.description}}</view><view class="muted">队伍：{{record.team}}</view><view wx:if="{{record.votes.length}}" class="votes-list"><text wx:for="{{record.votes}}" wx:key="id" class="vote-chip {{item.approve ? 'approve' : 'reject'}}">{{item.name}} {{item.approve ? '✓' : '×'}}</text></view></view></view>
      <button class="quiet" bindtap="leave">{{host ? '解散房间' : '退出房间'}}</button><view class="muted foreground-tip">房主请保持前台。离线玩家使用原设备恢复连接。</view>
    </block>
  </block>
  <view class="rules-toggle row" bindtap="toggleRules"><text>怎么玩阿瓦隆</text><text>{{rulesOpen ? '收起 −' : '展开 ＋'}}</text></view>
  <view wx:if="{{rulesOpen}}" class="card rules"><view>1. 5～10 人随机分为亚瑟与邪恶阵营，每人秘密查看身份。</view><view>2. 队长选出规定人数的队伍，全员同时投票，过半赞成通过。否决后顺时针换队长，连续五次否决则邪恶获胜。</view><view>3. 队员秘密出任务牌。好人只能出成功，坏人可出成功或失败。通常一张失败即任务失败；7 人及以上的第四轮需两张失败。</view><view>4. 三次任务失败则邪恶获胜。三次成功后，刺客还有一次机会：命中梅林则邪恶获胜，否则亚瑟阵营获胜。</view><view>5. 梅林看见除莫德雷德外的坏人；派西维尔看见梅林与莫甘娜候选。奥伯伦与其他坏人互不相认。</view><view class="muted">本版不包含湖中仙女、兰斯洛特等扩展。讨论在同桌口头进行。</view></view>
</view>
