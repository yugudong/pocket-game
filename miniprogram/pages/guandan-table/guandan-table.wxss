@media(max-height:350px){.seat-0{bottom:12px}.out-0{left:5px;bottom:108px;max-width:78px;transform:none}.out-0 .played-cards{flex-wrap:wrap;gap:2px}.out-0 .mini-card{flex:none;width:14px;height:22px;padding:1px;font-size:9px;line-height:9px}.out-0 .mini-card text:first-child{font-size:9px;line-height:9px}.out-0 .mini-card+.mini-card{margin-left:0}.out-0 .play-label{margin-top:3px;font-size:11px}}
.exchange-mark{position:absolute;bottom:2px;left:2px;font-size:10px;line-height:12px;background:#426f57;color:#fff8dd;padding:0 2px;border-radius:2px}
.round-result{width:540px;max-width:calc(100% - 24px);padding:12px 16px;overflow:hidden}.result-body{height:calc(100vh - var(--top-inset) - 142px);max-height:420px;overflow-y:auto}.remaining-title{font-size:14px;font-weight:700;padding:8px 0 4px;border-top:1px solid #dce3cf;margin-top:10px}.remaining-row{padding:6px 0;border-bottom:1px solid #e1e7d7}.remaining-player{display:flex;justify-content:space-between;gap:10px;font-size:13px;line-height:18px;margin-bottom:4px}.remaining-player text:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:75%}.remaining-player text:last-child{color:#84906b;white-space:nowrap}.remaining-cards{display:flex;flex-wrap:wrap;gap:3px;align-items:center;padding:2px 0}.remaining-card{width:25px;height:34px;flex:none;background:#fffdf5;color:#294633;border:1px solid #cdd5c0;border-radius:4px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:13px;line-height:15px}.remaining-card.red{color:#b14b44}.remaining-card.joker-mini text:first-child{font-size:10px}.no-remaining{font-size:12px;color:#8b9576;line-height:22px}
.round-info-backdrop{position:absolute;inset:0;background:#102a2666;z-index:20;display:flex;align-items:center;justify-content:center;padding:12px}.round-info-panel{width:440px;max-width:100%;max-height:calc(100vh - 24px);padding:16px;border-radius:14px;background:#faf5e5;color:#345540;box-shadow:0 8px 25px #082c2850}.round-info-body{height:180px;max-height:calc(100vh - 132px);overflow-y:auto;margin-top:10px}.round-info-note{font-size:14px;line-height:21px;margin:5px 0 10px;color:#71805e}.exchange-row{padding:6px 0 10px;border-bottom:1px solid #dce3cf}.exchange-route{font-size:15px;font-weight:650;line-height:20px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.exchange-cards{display:flex;align-items:center;gap:10px;margin-top:6px;font-size:13px;color:#7b8765}.info-card{width:34px;height:45px;border:1px solid #cdd5c0;border-radius:5px;background:#fffdf5;color:#294633;display:flex;flex-direction:column;justify-content:center;align-items:center;line-height:19px;font-size:17px;flex:none}.info-card.red{color:#b14b44}.info-card.joker-mini text:first-child{font-size:12px}.waiting-return{color:#939b80;font-size:12px}.round-info-panel .result-buttons .table-button{padding:0 18px}
@media(max-height:350px){.result-title{font-size:18px}.result-note{margin:4px 0}.result-body{height:calc(100vh - var(--top-inset) - 134px)}.round-result{top:calc(var(--top-inset) + 18px)}.round-info-panel{padding:12px 16px}.round-info-body{height:166px;max-height:calc(100vh - 120px)}}
