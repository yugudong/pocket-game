page{background:#234f3c;color:#fff5dc;overflow:hidden;font-size:15px}
.game-stage{position:fixed;inset:0;overflow:hidden;background:radial-gradient(ellipse at 50% 30%,#3c7654,#234f3c 75%);color:#fff5dc}
.table-header{position:absolute;inset:0 0 auto;z-index:8;font-size:11px;pointer-events:none}.header-left{position:absolute;left:max(12px,env(safe-area-inset-left));top:7px;width:calc(50% - 118px);pointer-events:auto}.header-right{position:absolute;right:max(14px,env(safe-area-inset-right));top:var(--top-inset);display:flex;gap:14px;pointer-events:auto}
.table-brand{font-size:17px;font-weight:700;white-space:nowrap}.table-brand text{font-size:12px;color:#b6c9b0;font-weight:400;margin-left:8px}.team-score{display:flex;gap:8px;align-items:center;margin-top:5px;font-size:12px;white-space:nowrap}.current-level{color:#efd79a;font-weight:650}.header-link{font-size:14px;color:#c4d8b7;white-space:nowrap}.felt-ring{position:absolute;left:50%;top:32px;transform:translateX(-50%);width:68%;height:39%;border:1px solid #9cae6c44;border-radius:50%;pointer-events:none}
.table-seat{position:absolute;z-index:3;width:80px;text-align:center;padding:3px;border-radius:10px}.seat-0{bottom:42px;left:max(8px,env(safe-area-inset-left))}.seat-1{left:max(8px,env(safe-area-inset-left));top:56px}.seat-3{right:max(8px,env(safe-area-inset-right));top:68px}.seat-2{top:max(3px,env(safe-area-inset-top));left:50%;transform:translateX(-50%);width:200px;display:flex;align-items:center;justify-content:center;gap:7px}
.player-chip{width:32px;height:32px;line-height:32px;font-size:14px;font-weight:700;border-radius:50%;background:#8d987a;color:#fff6de;margin:0 auto 3px}.ally-chip{background:#c6dba4;color:#365840}.seat-2 .player-chip{flex:none;margin:0}.seat-2 .seat-copy{display:grid;grid-template-columns:minmax(0,1fr) auto;column-gap:4px;width:152px;max-width:152px;text-align:left}.seat-2 .player-status{grid-column:1 / -1}.seat-2 .player-count{line-height:18px;white-space:nowrap}.player-name{font-size:14px;line-height:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%}.player-count{font-size:15px;color:#ffe299;font-weight:650;line-height:18px}.player-status{font-size:12px;color:#bacdb0;min-height:14px;line-height:14px}.turn{background:#d9d09316;box-shadow:inset 0 0 0 1px #e6c985}.turn .player-status{color:#ffe299}.offline{opacity:.5}
.seat-play{position:absolute;z-index:2;text-align:center;pointer-events:none}.out-2{left:50%;top:48px;transform:translateX(-50%)}.out-1{left:100px;top:64px;max-width:calc(35vw - 106px)}.out-3{right:100px;top:64px;max-width:calc(35vw - 106px)}.out-0{bottom:calc(var(--hand-height) + var(--bottom-inset) + 56px);left:50%;transform:translateX(-50%)}.out-0,.out-2{max-width:min(240px,30vw)}.played-cards{display:flex;justify-content:center;align-items:center;gap:2px}.mini-card{width:24px;height:34px;background:#fff9e9;color:#284234;border:1px solid #ded7b8;border-radius:4px;box-shadow:0 2px 3px #102c2d33;padding:2px 1px;display:flex;flex-direction:column;font-size:13px;line-height:14px;font-weight:650}.mini-card+.mini-card{margin-left:-4px}.mini-card text:first-child{white-space:nowrap;font-size:12px}.red{color:#b14b44}.wild-card{background:#fff0c7!important;border-color:#ceac64!important}.play-label{color:#c1d0b1;font-size:14px;line-height:17px;margin-top:4px;white-space:nowrap}.winning-play .play-label{color:#ffe398}.winning-play .mini-card{border-color:#dcc378}.pass-label{color:#c4d2b9;font-size:17px;padding:8px 16px;border-radius:20px;background:#103c322b}
.table-message{position:absolute;left:50%;top:85px;transform:translateX(-50%);text-align:center;font-size:17px;color:#e4dfb0}.table-message text{display:block;margin-top:4px;font-size:14px;color:#b3c6a6}.table-notice{position:absolute;top:55px;left:12px;max-width:28%;background:#643d23ed;color:#ffebbd;font-size:13px;padding:7px 10px;border-radius:8px;z-index:12;line-height:1.5}.table-notice text+text{margin-left:8px;text-decoration:underline}
.own-hand{position:absolute;bottom:var(--bottom-inset);left:var(--hand-left);right:var(--hand-right);height:var(--hand-height);z-index:4}.hand-area{width:100%;height:100%}.hand-columns{display:flex;align-items:flex-end;justify-content:center;width:100%;height:100%;padding:4px 4px 2px;gap:0}.hand-column{display:block;flex:none;width:var(--card-width);white-space:normal}.hand-column+.hand-column{margin-left:var(--column-gap)}.column-stack{position:relative;width:100%}.playing-card{position:absolute;left:0;width:100%;height:52px;background:#fff9ec;border:1px solid #c4ccb6;border-radius:4px;box-shadow:-1px 1px 2px #143e2c40;color:#294633;padding:0 1px;transition:transform .1s}.card-corner{display:flex;align-items:center;gap:1px;height:13px;line-height:13px;font-size:var(--rank-size);font-weight:700;white-space:nowrap}.card-suit{font-size:var(--suit-size);font-weight:400}.joker-rank{font-size:min(10px,var(--rank-size))}.joker-rank+.card-suit{display:none}.card-center{display:block;text-align:center;font-size:27px;line-height:35px}.wild-mark{position:absolute;bottom:2px;right:2px;font-size:10px;background:#bd9444;color:#fff;padding:0 1px;border-radius:2px}.playing-card.red{color:#b14b44}.playing-card.selected{border-color:#e8bf63;background:#e2edce;box-shadow:0 0 0 1px #e8bf63}.playing-card.ineligible{opacity:.45}.hidden-hand{display:flex;align-items:center;justify-content:center;height:100%;font-size:16px;border:1px dashed #83a26b66;border-radius:12px;color:#b9cfa8}.finished-hand{padding:30px;font-size:15px;color:#b9cfa8}
.hand-controls{position:absolute;left:var(--hand-left);right:var(--hand-right);bottom:calc(var(--hand-height) + var(--bottom-inset) + 18px);z-index:5;text-align:center}.action-row{display:flex;justify-content:center;align-items:center;gap:6px}.table-button{width:auto;min-width:48px;height:32px;font-size:14px;line-height:30px;padding:0 12px;border-radius:9px;background:#e8eedc;color:#315941;margin:0;font-weight:600;white-space:nowrap}.table-button[disabled]{background:#d1dcc550!important;color:#b5c3a282!important}.play-button{background:#e6c675;color:#594722;min-width:66px}.arrange-button{background:#bcd09f;color:#315b3f}.quiet-button{background:#163d2c6e;color:#c5d6b5;border:1px solid #668859}.selection-caption{position:absolute;top:35px;left:4px;right:0;text-align:center;font-size:12px;line-height:14px;color:#e1e5c4;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;pointer-events:none}.combo-choices{position:absolute;bottom:36px;left:0;right:0;width:100%;height:29px;white-space:nowrap;border-radius:8px;background:#1b493be8}.combo-line{display:inline-flex;gap:5px;padding:2px 5px}.combo-choice{display:inline-block;padding:3px 8px;font-size:12px;border:1px solid #698b5b;border-radius:6px;color:#cbdcbc}.combo-choice.active{background:#e3d093;color:#4c522e;border-color:#e3d093}.pending-state{position:absolute;bottom:4px;left:12px;font-size:12px;color:#ffe398}
.round-result{position:absolute;top:calc(var(--top-inset) + 25px);left:50%;transform:translateX(-50%);width:300px;max-height:calc(100% - var(--top-inset) - 36px);overflow:auto;padding:14px 18px;border-radius:14px;background:#faf5e5;color:#345540;box-shadow:0 8px 25px #082c2850;z-index:9}.result-title{font-size:20px;font-weight:700}.result-note{font-size:13px;color:#889369;margin:6px 0}.finish-list{display:grid;grid-template-columns:1fr 1fr;gap:6px;font-size:14px;margin:10px 0}.finish-list view{display:flex;flex-direction:column;gap:2px}.finish-list text:first-child{font-size:12px;color:#8c9b73}.result-buttons{display:flex;gap:10px;justify-content:center;margin-top:10px}.result-buttons .table-button{background:#e3ebd3}.result-buttons .play-button{background:#e6c675}.loading-table{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;font-size:15px}.loading-title{font-size:24px;font-weight:700}
.out-1 .mini-card,.out-2 .mini-card,.out-3 .mini-card{width:36px;height:46px;padding:2px 1px;font-size:18px;line-height:20px}.out-1 .mini-card text:first-child,.out-2 .mini-card text:first-child,.out-3 .mini-card text:first-child{font-size:15px;line-height:17px}.out-1 .mini-card+.mini-card,.out-2 .mini-card+.mini-card,.out-3 .mini-card+.mini-card{margin-left:-8px}.mini-card.joker-mini text:first-child{font-size:9px}.out-1 .joker-mini text:first-child,.out-2 .joker-mini text:first-child,.out-3 .joker-mini text:first-child{font-size:12px}
