<view class="game-stage" style="--top-inset:{{topInset}}px;--hand-left:{{handLayout.left}}px;--hand-right:{{handLayout.right}}px;--bottom-inset:{{handLayout.bottom}}px;--hand-height:{{handLayout.height}}px;--card-width:{{handLayout.cardWidth}}px;--column-gap:{{handLayout.gap}}px;--rank-size:{{handLayout.rankSize}}px;--suit-size:{{handLayout.suitSize}}px;">
  <view wx:if="{{sharePreview}}" class="loading-table"><view class="loading-title">口袋掼蛋</view><view>请通过“前往小程序”进入完整牌桌。</view></view>
  <view wx:elif="{{loading || !view || !inGame}}" class="loading-table"><view class="loading-title">正在进入横屏牌桌…</view><view wx:if="{{error}}">{{error}}</view><button class="table-button" bindtap="restore">重新连接</button><button class="table-button" bindtap="enterTable">重新进入</button><button class="table-button quiet-button" bindtap="continueOther">返回房间</button></view>
  <block wx:else>
    <view class="table-header"><view class="header-left"><view class="table-brand">口袋掼蛋<text>第 {{view.round}} 副</text></view><view class="team-score"><text>一队 {{teamLevels[0]}}</text><text class="current-level">打 {{levelName}} · ♥{{levelName}} 配</text><text>二队 {{teamLevels[1]}}</text></view></view><view class="header-right"><text wx:if="{{hasRoundInfo}}" class="header-link" bindtap="showRoundInfo">{{view.antiTribute ? '抗贡' : '贡还'}}</text><text class="header-link" bindtap="toggleHand">{{hideHand ? '展开' : '收牌'}}</text><text class="header-link" bindtap="gameRules">玩法</text><text class="header-link" bindtap="leave">退出</text></view></view>
    <view class="felt-ring"></view>
    <view wx:if="{{error || networkMessage || !connected}}" class="table-notice"><text>{{error || networkMessage || '连接已暂停，请让房主回到前台'}}</text><text wx:if="{{!connected}}" bindtap="restore">重连 →</text><text wx:if="{{error}}" bindtap="clearError">×</text></view>
    <block wx:for="{{players}}" wx:key="id">
      <view class="table-seat seat-{{item.position}} {{item.active ? 'turn' : ''}} {{!item.online ? 'offline' : ''}}"><view class="player-chip {{item.teammate ? 'ally-chip' : ''}}">{{item.bot ? 'AI' : item.initial}}</view><view class="seat-copy"><view class="player-name">{{item.name}}{{item.me ? ' · 你' : ''}}</view><view wx:if="{{item.placeName}}" class="player-count">{{item.placeName}}</view><view wx:elif="{{item.showCount}}" class="player-count">剩 {{item.count}} 张</view><view class="player-status">{{item.status}}</view></view></view>
      <view class="seat-play {{item.outCards.length > 6 ? 'long-play' : ''}} out-{{item.position}} {{item.winning ? 'winning-play' : ''}}"><view wx:if="{{item.outType === 'pass'}}" class="pass-label">不出</view><block wx:elif="{{item.outCards.length}}"><view class="played-cards"><view wx:for="{{item.outCards}}" wx:for-item="played" wx:key="id" class="mini-card {{played.rank >= 15 ? 'joker-mini' : ''}} {{played.red ? 'red' : ''}} {{played.wild ? 'wild-card' : ''}}"><text>{{played.label}}</text><text>{{played.symbol}}</text></view></view><view class="play-label">{{item.outLabel}}</view></block></view>
    </block>
    <view wx:if="{{!over && view.phase === 'tribute'}}" class="table-message">{{exchangeGiving ? turnName+' 选择进贡花色' : turnName+' 还贡给 '+returnName}}<text>{{exchangeGiving ? '选一张亮起的最高牌，红心级牌不进贡' : '选一张不超过 10 的非级牌 · 点“贡还”查看贡牌'}}</text></view>
    <view wx:elif="{{!over && !view.last}}" class="table-message">{{turnName}} 领出<text>开始新一圈</text></view>
    <view wx:if="{{over}}" class="round-result"><view class="result-title">{{view.phase === 'matchOver' ? (view.result.winner === my.team ? '你们打过 A，赢下整局！' : '对方打过 A，赢下整局') : resultTitle}}</view><view class="result-note">{{view.result.double ? '双上游，升 3 级' : '搭档 '+view.result.place+' 游，升 '+view.result.upgrade+' 级'}}{{view.phase === 'roundOver' ? ' · 下副打 '+levelName : ''}}</view>
      <scroll-view scroll-y class="result-body">
        <view class="remaining-title">本副剩余手牌</view>
        <view wx:for="{{remainingRows}}" wx:for-item="row" wx:key="id" class="remaining-row"><view class="remaining-player"><text>{{row.name}}{{row.me ? ' · 你' : ''}} · {{row.role}}</text><text>{{row.count ? '剩 '+row.count+' 张' : '已出完'}}</text></view><view class="remaining-cards"><view wx:for="{{row.cards}}" wx:key="id" class="remaining-card {{item.red ? 'red' : ''}} {{item.wild ? 'wild-card' : ''}} {{item.rank >= 15 ? 'joker-mini' : ''}}"><text>{{item.label}}</text><text>{{item.symbol}}</text></view><text wx:if="{{!row.count}}" class="no-remaining">没有剩余手牌</text></view></view>
      </scroll-view><view class="result-buttons"><button wx:if="{{host && view.phase === 'roundOver'}}" class="table-button play-button" disabled="{{!canAct}}" bindtap="next">下一副</button><button wx:if="{{host}}" class="table-button" disabled="{{!canAct}}" bindtap="again">回大厅重开</button><text wx:else>等待房主继续</text></view></view>
    <view wx:if="{{!over}}" class="hand-controls">
      <view wx:if="{{selected.length || hintText || view.phase === 'tribute'}}" class="selection-caption">{{hintText || (view.phase === 'tribute' && myTurn ? (exchangeGiving ? '选一张亮起的最高牌进贡，可选择花色' : '选一张亮起的牌还贡，收到的贡牌标有“贡”') : selectedMessage)}}</view>
      <scroll-view wx:if="{{comboOptions.length > 1 && selected.length && myTurn}}" class="combo-choices" scroll-x><view class="combo-line"><text wx:for="{{comboOptions}}" wx:key="key" class="combo-choice {{comboKey === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="chooseCombo">{{item.label}}</text></view></scroll-view>
      <view class="action-row"><button class="table-button" disabled="{{!canAct || !myTurn || hideHand}}" bindtap="hint">提示</button><button class="table-button play-button" disabled="{{!canAct || !myTurn || hideHand || (view.phase === 'tribute' ? selected.length !== 1 : !comboKey)}}" bindtap="play">{{view.phase === 'tribute' ? (exchangeGiving ? '进贡' : '还贡') : '出牌'}}</button><button class="table-button" disabled="{{!canAct || !myTurn || view.phase !== 'play' || !view.last}}" bindtap="pass">不出</button><button class="table-button" disabled="{{!selected.length}}" bindtap="clear">清空</button><button class="table-button arrange-button" disabled="{{!canArrange || !selected.length}}" bindtap="arrange">手动理牌</button><button class="table-button quiet-button" disabled="{{!canArrange}}" bindtap="autoArrange">自动理牌</button></view>
    </view>
    <view wx:if="{{!over}}" class="own-hand"><view wx:if="{{hideHand}}" class="hidden-hand" bindtap="toggleHand">手牌已收起 · 点此展开</view><view wx:else class="hand-area" bindtouchstart="startSwipe" catchtouchmove="moveSwipe" bindtouchend="endSwipe" bindtouchcancel="cancelSwipe"><view class="hand-columns"><view wx:for="{{handColumns}}" wx:for-item="column" wx:key="key" class="hand-column" data-id="{{column.groupKey}}" bindlongpress="selectColumn"><view class="column-stack" style="height:{{column.height}}px"><view wx:for="{{column.cards}}" wx:key="id" class="playing-card {{item.red ? 'red' : ''}} {{item.wild ? 'wild-card' : ''}} {{item.selected ? 'selected' : ''}} {{!item.eligible ? 'ineligible' : ''}}" style="top:{{item.top}}px" data-id="{{item.id}}" bindtap="selectCard"><view class="card-corner"><text class="card-rank {{item.rank >= 15 ? 'joker-rank' : ''}}">{{item.label}}</text><text class="card-suit">{{item.symbol}}</text></view><text class="card-center">{{item.symbol}}</text><text wx:if="{{item.wild}}" class="wild-mark">配</text><text wx:if="{{item.exchangeMark}}" class="exchange-mark">{{item.exchangeMark}}</text></view></view></view><view wx:if="{{!handColumns.length}}" class="finished-hand">你的手牌已出完</view></view></view></view>
    <view wx:if="{{roundInfoOpen}}" class="round-info-backdrop"><view class="round-info-panel"><view class="result-title">{{roundInfoTitle}}</view><scroll-view scroll-y class="round-info-body">
      <block wx:if="{{view.antiTribute}}"><view class="round-info-note">应贡方合计持有两张大王，本副无需进贡、还贡。</view><view class="anti-holder-list"><view wx:for="{{antiHolders}}" wx:for-item="holder" wx:key="seat" class="exchange-row"><view class="exchange-route">{{holder.name}} · 开局大王</view><view class="exchange-cards"><view wx:for="{{holder.cards}}" wx:key="id" class="info-card red joker-mini"><text>{{item.label}}</text><text>{{item.symbol}}</text></view></view></view></view><view class="round-info-note">上副头游 {{roundInfoLead}} 先出。</view></block>
      <block wx:else><view wx:if="{{!tributeRows.length}}" class="round-info-note">等待 {{turnName}} 选择进贡花色。</view><view wx:for="{{tributeRows}}" wx:for-item="gift" wx:key="key" class="exchange-row"><view class="exchange-route">{{gift.from}} → {{gift.to}}</view><view class="exchange-cards"><text>进贡</text><view class="info-card {{gift.card.red ? 'red' : ''}} {{gift.card.rank >= 15 ? 'joker-mini' : ''}}"><text>{{gift.card.label}}</text><text>{{gift.card.symbol}}</text></view><text>还贡</text><view wx:if="{{gift.returnCard}}" class="info-card {{gift.returnCard.red ? 'red' : ''}} {{gift.returnCard.rank >= 15 ? 'joker-mini' : ''}}"><text>{{gift.returnCard.label}}</text><text>{{gift.returnCard.symbol}}</text></view><text wx:else class="waiting-return">等待还贡</text></view></view><view class="round-info-note">收到的贡牌、还牌会在手牌上标记“贡”“还”。</view></block>
    </scroll-view><view class="result-buttons"><button class="table-button play-button" bindtap="closeRoundInfo">{{view.phase === 'tribute' ? '知道了，继续贡还' : '知道了'}}</button></view></view></view>
    <view wx:if="{{busy}}" class="pending-state">确认中…</view>
  </block>
</view>
