<view class="game-stage" style="--top-inset:{{topInset}}px;--hand-left:{{handLayout.left}}px;--hand-right:{{handLayout.right}}px;--bottom-inset:{{handLayout.bottom}}px;--hand-height:{{handLayout.height}}px;--card-width:{{handLayout.cardWidth}}px;--column-gap:{{handLayout.gap}}px;--rank-size:{{handLayout.rankSize}}px;--suit-size:{{handLayout.suitSize}}px;">
  <view wx:if="{{sharePreview}}" class="loading-table"><view class="loading-title">口袋斗地主</view><view>请通过“前往小程序”进入完整牌桌。</view></view>
  <view wx:elif="{{loading || !view || !inGame}}" class="loading-table"><view class="loading-title">正在进入横屏牌桌…</view><view wx:if="{{error}}">{{error}}</view><button class="table-button" bindtap="restore">重新连接</button><button class="table-button" bindtap="enterTable">重新进入</button><button class="table-button quiet-button" bindtap="continueOther">返回房间</button></view>
  <block wx:else>
    <view class="table-header"><view class="header-left"><view class="table-brand">口袋斗地主<text>第 {{view.round}} 副</text></view><view class="team-score"><text>{{myRole}} · 积分 {{my.score}}</text></view></view><view class="header-right"><text class="header-link" bindtap="toggleHand">{{hideHand ? '展开' : '收牌'}}</text><text class="header-link" bindtap="gameRules">玩法</text><text class="header-link" bindtap="leave">退出</text></view></view>
    <view class="felt-ring"></view>
    <view class="bottom-panel"><view>底牌</view><view class="bottom-cards"><block wx:if="{{bottomCards.length}}"><view wx:for="{{bottomCards}}" wx:key="id" class="bottom-card {{item.red ? 'red' : ''}} {{item.rank >= 15 ? 'joker-mini' : ''}}"><text>{{item.label}}</text><text>{{item.symbol}}</text></view></block><block wx:else><view class="bottom-card face-down">?</view><view class="bottom-card face-down">?</view><view class="bottom-card face-down">?</view></block></view><view class="bottom-caption">{{view.phase === 'bid' ? '叫分后亮底牌' : '底分 '+view.bid+' · '+view.multiplier+' 倍'}}</view></view>
    <view wx:if="{{error || networkMessage || !connected}}" class="table-notice"><text>{{error || networkMessage || '连接已暂停，请让房主回到前台'}}</text><text wx:if="{{!connected}}" bindtap="restore">重连 →</text><text wx:if="{{error}}" bindtap="clearError">×</text></view>
    <block wx:for="{{players}}" wx:key="id">
      <view class="table-seat seat-{{item.position}} {{item.active ? 'turn' : ''}} {{!item.online ? 'offline' : ''}} {{item.role === '地主' ? 'landlord-seat' : ''}}"><view class="player-chip {{item.teammate ? 'ally-chip' : ''}}">{{item.bot ? 'AI' : item.initial}}</view><view class="seat-copy"><view class="player-name">{{item.name}}{{item.me ? ' · 你' : ''}}</view><view wx:if="{{item.role !== '待定'}}" class="player-role">{{item.role}}</view><view wx:if="{{item.placeName}}" class="player-count">{{item.placeName}}</view><view wx:elif="{{item.showCount}}" class="player-count">剩 {{item.count}} 张</view><view class="player-status">{{item.status}}</view></view></view>
      <view class="seat-play {{item.outCards.length > 10 ? 'mass-play' : ''}} {{item.outCards.length > 6 ? 'long-play' : ''}} out-{{item.position}} {{item.winning ? 'winning-play' : ''}}"><view wx:if="{{item.outType === 'pass'}}" class="pass-label">不出</view><block wx:elif="{{item.outCards.length}}"><view class="played-cards"><view wx:for="{{item.outCards}}" wx:for-item="played" wx:key="id" class="mini-card {{played.rank >= 15 ? 'joker-mini' : ''}} {{played.red ? 'red' : ''}} {{played.wild ? 'wild-card' : ''}}"><text>{{played.label}}</text><text>{{played.symbol}}</text></view></view><view class="play-label">{{item.outLabel}}</view></block></view>
    </block>
    <view wx:if="{{!over && view.phase === 'bid'}}" class="table-message">{{myTurn ? '轮到你叫分' : turnName+' 正在叫分'}}<text>{{view.bid ? '目前最高 '+view.bid+' 分' : '地主确定后拿三张底牌'}}</text></view>
    <view wx:elif="{{!over && !view.last}}" class="table-message">{{turnName}} 领出<text>{{myTurn ? '选牌后点出牌' : '等待出牌'}}</text></view>
    <view wx:if="{{over}}" class="round-result"><view class="result-title">{{resultTitle}} · {{view.result.winner === 0 ? '地主胜' : '农民胜'}}</view><view class="result-note">底分 {{view.result.bid}} · {{view.result.multiplier}} 倍{{view.result.spring ? ' · '+view.result.spring : ''}}</view>
      <scroll-view scroll-y class="result-body">
        <view class="remaining-title">本副剩余手牌</view><view wx:for="{{remainingRows}}" wx:for-item="row" wx:key="id" class="remaining-row"><view class="remaining-player"><text>{{row.name}}{{row.me ? ' · 你' : ''}} · {{row.role}}</text><text>{{row.count ? '剩 '+row.count+' 张' : '已出完'}}</text></view><view class="remaining-cards"><view wx:for="{{row.cards}}" wx:key="id" class="remaining-card {{item.red ? 'red' : ''}} {{item.rank >= 15 ? 'joker-mini' : ''}}"><text>{{item.label}}</text><text>{{item.symbol}}</text></view><text wx:if="{{!row.count}}" class="no-remaining">没有剩余手牌</text></view></view>
        <view class="score-list"><view wx:for="{{scoreRows}}" wx:key="id" class="score-row"><view class="score-name">{{item.name}} · {{item.role}}</view><text class="{{item.delta > 0 ? 'positive' : ''}}">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</text><text class="score-total">累计 {{item.score}}</text></view></view>
      </scroll-view><view class="result-buttons"><button wx:if="{{host}}" class="table-button play-button" disabled="{{!canAct}}" bindtap="next">下一副</button><button wx:if="{{host}}" class="table-button" disabled="{{!canAct}}" bindtap="again">返回大厅</button><text wx:else>等待房主继续</text></view></view>
    <view wx:if="{{!over}}" class="hand-controls">
      <view wx:if="{{view.phase === 'bid'}}" class="action-row bid-actions"><block wx:if="{{myTurn}}"><button wx:for="{{bidChoices}}" wx:key="value" class="table-button {{item.value === 3 ? 'play-button' : ''}}" disabled="{{!canAct}}" data-value="{{item.value}}" bindtap="bid">{{item.label}}</button></block><view wx:else class="bid-caption">等待 {{turnName}} 叫分 · 可以先理牌</view><button class="table-button arrange-button" disabled="{{!canArrange || !selected.length}}" bindtap="arrange">手动理牌</button><button class="table-button quiet-button" disabled="{{!canArrange}}" bindtap="autoArrange">自动理牌</button></view>
      <view wx:if="{{selected.length || hintText || view.phase === 'tribute'}}" class="selection-caption">{{hintText || (view.phase === 'tribute' && myTurn ? '选一张亮起的牌还贡' : selectedMessage)}}</view>
      <scroll-view wx:if="{{comboOptions.length > 1 && selected.length && myTurn}}" class="combo-choices" scroll-x><view class="combo-line"><text wx:for="{{comboOptions}}" wx:key="key" class="combo-choice {{comboKey === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="chooseCombo">{{item.label}}</text></view></scroll-view>
      <view wx:if="{{view.phase === 'play'}}" class="action-row"><button class="table-button" disabled="{{!canAct || !myTurn || hideHand}}" bindtap="hint">提示</button><button class="table-button play-button" disabled="{{!canAct || !myTurn || hideHand || (view.phase === 'tribute' ? selected.length !== 1 : !comboKey)}}" bindtap="play">{{view.phase === 'tribute' ? '还贡' : '出牌'}}</button><button class="table-button" disabled="{{!canAct || !myTurn || view.phase !== 'play' || !view.last}}" bindtap="pass">不出</button><button class="table-button" disabled="{{!selected.length}}" bindtap="clear">清空</button><button class="table-button arrange-button" disabled="{{!canArrange || !selected.length}}" bindtap="arrange">手动理牌</button><button class="table-button quiet-button" disabled="{{!canArrange}}" bindtap="autoArrange">自动理牌</button></view>
    </view>
    <view wx:if="{{!over}}" class="own-hand"><view wx:if="{{hideHand}}" class="hidden-hand" bindtap="toggleHand">手牌已收起 · 点此展开</view><view wx:else class="hand-area" bindtouchstart="startSwipe" catchtouchmove="moveSwipe" bindtouchend="endSwipe" bindtouchcancel="cancelSwipe"><view class="hand-columns"><view wx:for="{{handColumns}}" wx:for-item="column" wx:key="key" class="hand-column" data-id="{{column.groupKey}}" bindlongpress="selectColumn"><view class="column-stack" style="height:{{column.height}}px"><view wx:for="{{column.cards}}" wx:key="id" class="playing-card {{item.red ? 'red' : ''}} {{item.wild ? 'wild-card' : ''}} {{item.selected ? 'selected' : ''}} {{!item.eligible ? 'ineligible' : ''}}" style="top:{{item.top}}px" data-id="{{item.id}}" bindtap="selectCard"><view class="card-corner"><text class="card-rank {{item.rank >= 15 ? 'joker-rank' : ''}}">{{item.label}}</text><text class="card-suit">{{item.symbol}}</text></view><text class="card-center">{{item.symbol}}</text><text wx:if="{{item.wild}}" class="wild-mark">配</text></view></view></view><view wx:if="{{!handColumns.length}}" class="finished-hand">你的手牌已出完</view></view></view></view>
    <view wx:if="{{busy}}" class="pending-state">确认中…</view>
  </block>
</view>
