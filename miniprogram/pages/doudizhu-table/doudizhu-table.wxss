@import "../guandan-table/guandan-table.wxss";
.game-stage{background:radial-gradient(ellipse at 50% 30%,#386b68,#204b49 75%)}
.seat-1{top:64px}.seat-3{top:72px}.seat-0{bottom:14px}.player-role{font-size:12px;color:#bcd3c5;line-height:16px}.landlord-seat .player-role{color:#ffdc91}.landlord-seat .player-chip{background:#e2be70;color:#604925}.landlord-seat.turn{box-shadow:inset 0 0 0 1px #e9c981}
.bottom-panel{position:absolute;top:3px;line-height:13px;left:50%;transform:translateX(-50%);z-index:3;text-align:center;width:144px;font-size:12px;color:#c6d7c0}.bottom-cards{display:flex;justify-content:center;gap:4px;margin-top:4px}.bottom-card{width:27px;height:33px;background:#fff9e9;color:#284234;border:1px solid #d9ccb0;border-radius:4px;font-size:13px;line-height:15px;display:flex;flex-direction:column;justify-content:center}.bottom-card.red{color:#b14b44}.bottom-card.joker-mini{font-size:10px}.bottom-card.face-down{background:repeating-linear-gradient(45deg,#536f74,#536f74 3px,#436066 3px,#436066 6px);border-color:#9bada0;color:#d5dfcd;font-size:18px;line-height:30px}.bottom-caption{line-height:13px;margin-top:3px;font-size:12px;color:#efdaa6;white-space:nowrap}
.header-left{width:calc(50% - 94px)}.team-score{display:block}.out-1{top:72px;left:calc(max(8px,env(safe-area-inset-left)) + 94px);max-width:calc(42vw - max(8px,env(safe-area-inset-left)) - 100px)}.out-3{top:72px;right:calc(max(8px,env(safe-area-inset-right)) + 94px);max-width:calc(42vw - max(8px,env(safe-area-inset-right)) - 100px)}.out-0{bottom:calc(var(--hand-height) + var(--bottom-inset) + 57px)}.seat-play .played-cards{flex-wrap:wrap;gap:2px;row-gap:3px}.seat-play .mini-card{flex-shrink:0}.out-1 .mini-card,.out-3 .mini-card{width:30px;height:43px;font-size:16px;line-height:19px}.out-1 .mini-card+.mini-card,.out-3 .mini-card+.mini-card{margin-left:-13px}.out-1 .mini-card text:first-child,.out-3 .mini-card text:first-child{font-size:13px;line-height:16px}.out-1 .joker-mini text:first-child,.out-3 .joker-mini text:first-child{font-size:10px}.out-1 .mini-card:first-child,.out-3 .mini-card:first-child{margin-left:0}.table-message{top:96px;font-size:16px;width:260px;max-width:50%;line-height:20px}.bid-caption{min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:13px;color:#efe3b9;white-space:nowrap}.bid-actions .table-button{min-width:65px}.hand-controls{right:max(84px,calc(env(safe-area-inset-right) + 76px));bottom:calc(var(--hand-height) + var(--bottom-inset) + 18px)}.round-result{top:72px;max-height:calc(100% - 84px);width:330px}.score-list{margin-top:12px}.score-row{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:14px;padding:6px 0;border-bottom:1px solid #dce3cf}.score-name{max-width:145px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.score-row .positive{color:#a66f2b;font-weight:700}.score-total{color:#7d8e72;font-size:12px}
.table-seat{width:76px}
.out-0{max-width:calc(16vw - 10px)}.out-0 .mini-card{width:14px;height:24px;font-size:9px;line-height:10px;padding:1px}.out-0 .mini-card text:first-child{font-size:9px;line-height:11px}.out-0 .mini-card+.mini-card{margin-left:-6px}
@media(max-width:720px){.out-1 .mini-card,.out-3 .mini-card{width:26px;height:36px;font-size:14px;line-height:16px}.out-1 .mini-card text:first-child,.out-3 .mini-card text:first-child{font-size:12px;line-height:14px}.out-1 .joker-mini text:first-child,.out-3 .joker-mini text:first-child{font-size:9px}.out-1 .mini-card+.mini-card,.out-3 .mini-card+.mini-card{margin-left:-12px}.long-play .mini-card text:first-child{font-size:11px}.table-message{top:90px}.bid-actions .table-button{min-width:57px}.bid-caption{font-size:12px}}
@media(max-height:350px){.out-1,.out-3{top:72px}.out-0{left:max(5px,env(safe-area-inset-left));bottom:94px;max-width:76px;transform:none}.out-0 .mini-card{width:12px;height:18px;font-size:8px;line-height:8px;padding:0 1px}.out-0 .mini-card text:first-child{font-size:7px;line-height:8px}.out-0 .mini-card+.mini-card{margin-left:-7px}.out-0 .play-label{font-size:10px;line-height:12px;margin-top:2px}.player-role{font-size:11px;line-height:14px}.seat-0 .player-role,.seat-0 .player-status{display:none}.mass-play.out-1 .mini-card,.mass-play.out-3 .mini-card{width:20px;height:22px;font-size:10px;line-height:10px;padding:0 1px}.mass-play.out-1 .mini-card text:first-child,.mass-play.out-3 .mini-card text:first-child{font-size:11px;line-height:10px}.mass-play.out-1 .mini-card+.mini-card,.mass-play.out-3 .mini-card+.mini-card{margin-left:-10px}.mass-play .play-label{font-size:11px;line-height:12px;margin-top:2px}.table-message{top:91px;font-size:15px}.table-message text{font-size:12px;line-height:16px}.round-result{top:69px}.selection-caption{font-size:11px}}

.round-result{width:540px;max-height:none}
