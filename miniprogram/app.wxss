page { background:#f7f4ec; color:#25382d; font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; font-size:28rpx; }
view,text,button,input { box-sizing:border-box; }
button { margin:0; font-size:28rpx; font-weight:600; border-radius:20rpx; line-height:1.4; padding:25rpx 28rpx; width:100%; min-width:0; background:#e9ece4; color:#294a3a; }
button::after { border:0; }
button[disabled] { background:#e6e5df !important; color:#9b9f98 !important; }
.primary { background:#24553e; color:#fff; }
.secondary { background:#e8eee6; color:#24553e; }
.danger { background:#fae8e4; color:#9d443d; }
.quiet { background:transparent; font-weight:400; color:#6f7e72; padding:18rpx; }
.page { padding:28rpx 32rpx 64rpx; padding-bottom:calc(64rpx + env(safe-area-inset-bottom)); }
.card { border:1rpx solid #e6e7dc; background:#fffefa; border-radius:28rpx; padding:30rpx; margin-bottom:24rpx; }
.row { display:flex; align-items:center; justify-content:space-between; }
.gap { gap:16rpx; }
.grow { flex:1; min-width:0; }
.title { font-size:42rpx; font-weight:700; letter-spacing:1rpx; }
.subtitle { font-size:32rpx; font-weight:650; }
.muted { color:#7b857b; font-size:24rpx; line-height:1.7; }
.small { font-size:23rpx; }
.label { display:block; color:#5f7061; font-size:25rpx; margin-bottom:14rpx; }
.input { height:88rpx; border:1rpx solid #dfe3d9; border-radius:18rpx; padding:0 22rpx; background:#f9faf5; margin-bottom:24rpx; font-size:28rpx; }
.tag { display:inline-block; background:#edf1e7; color:#5b7054; font-size:21rpx; padding:8rpx 16rpx; border-radius:30rpx; }
.spacer { height:24rpx; }
.notice { background:#fff0d4; color:#856637; padding:20rpx 24rpx; border-radius:18rpx; font-size:24rpx; line-height:1.6; margin-bottom:24rpx; }
.section-title { margin:32rpx 0 20rpx; font-size:30rpx; font-weight:650; }
